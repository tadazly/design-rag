{
  "name": "design-rag",
  "version": "0.3.0",
  "description": "DRAG（Design-RAG）本地游戏策划案与配置表知识库",
  "author": "tadazly",
  "license": "Apache-2.0",
  "repository": "https://github.com/tadazly/design-rag.git",
  "type": "module",
  "private": true,
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:binary": "node scripts/verify-binary-build-info.mjs",
    "verify:tag-plugin": "node scripts/verify-tag-plugin.mjs",
    "build:go": "node scripts/build-go-core.mjs",
    "test:go:fork": "cd third_party/nkiri-xls && go test ./... && go vet ./...",
    "test:go": "go test ./go/... && go vet ./go/... && npm run test:go:fork",
    "build:node": "tsc -p tsconfig.node.json",
    "build:renderer": "vite build",
    "build:test": "tsc -p tsconfig.test.json",
    "build": "npm run clean && npm run build:go && npm run build:node && npm run build:renderer",
    "check": "npm run clean && npm run test:go && npm run build:go && npm run build:test && npm run build:renderer",
    "test": "npm run clean && npm run test:go && npm run build:go && npm run build:test && node --test --test-isolation=none \"dist-tests/tests/*.test.js\"",
    "test:app-server": "npm run build:node && node scripts/smoke-app-server.mjs",
    "test:chat-live": "npm run build:node && node scripts/smoke-generated-chat.mjs",
    "test:retrieval-live": "npm run build:node && node scripts/smoke-retrieval-questions.mjs",
    "test:mcp-concurrency": "go test ./go/core -run TestBackgroundIndexJob -count=1",
    "test:dates:corpus": "npm run build:test && node --test --test-isolation=none dist-tests/tests/date-corpus.test.js",
    "test:mcp-stdio-all": "go test ./go/core ./go/pluginpack -run \"TestMCP|TestWindowsGoTestStage\" -count=1",
    "accept:go-full": "go run ./go/cmd/corpus-accept",
    "accept:evidence-ab": "npm run build:node && node scripts/compare-node-go-evidence.mjs",
    "test:electron-settings": "npm run build && node scripts/smoke-electron-settings.mjs",
    "test:electron-startup-incremental": "node scripts/smoke-electron-startup-incremental.mjs",
    "plugin:validate": "go run ./go/cmd/plugin-pack validate",
    "plugin:validate:static": "go run ./go/cmd/plugin-pack validate",
    "plugin:stage:win": "go run ./go/cmd/plugin-pack stage --target win32-x64",
    "plugin:stage:win:go-test": "go run ./go/cmd/plugin-pack stage --target win32-x64 --test-marker",
    "plugin:stage:mac": "go run ./go/cmd/plugin-pack stage --target darwin-arm64",
    "plugin:stage:mac:go-test": "go run ./go/cmd/plugin-pack stage --target darwin-arm64 --test-marker",
    "plugin:test:stages": "go test ./go/pluginpack -count=1",
    "plugin:pack:win": "go run ./go/cmd/plugin-pack pack --target win32-x64",
    "plugin:pack:mac": "go run ./go/cmd/plugin-pack pack --target darwin-arm64",
    "plugin:cross:mac-core": "npm run test:go && npm run build:go -- --target=darwin-arm64",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && npm run build:node && cross-env DESIGN_RAG_VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev": "concurrently -k -n renderer,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "start": "npm run build && electron .",
    "pack": "npm run build && node scripts/pack-electron.mjs",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "chardet": "2.2.0",
    "cheerio": "1.2.0",
    "fast-glob": "3.3.3",
    "fast-xml-parser": "5.11.1",
    "iconv-lite": "0.7.3",
    "jszip": "3.10.1",
    "lucide-react": "1.38.0",
    "mammoth": "1.12.2",
    "p-limit": "7.3.1",
    "pdf-parse": "2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "write-file-atomic": "8.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wait-on": "9.1.0"
  }
}
